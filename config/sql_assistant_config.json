  "business_rules": {
    "bin_presentation": {
      "description": "Bin presentation = bins that reached/were delivered to a station OR per bot. ALWAYS use task_master_log with TASK_TYPE IN ('STATION_TO_STATION','BIN_STORE_TO_ZONE') and STATUS='COMPLETED'. Count each completed task as one bin presentation. Group by BOT_ID for per-bot analysis, or join with hw_station_master on destination_location_id for per-station analysis.",
      "required_table": "task_master_log",
      "required_filters": [
        "TASK_TYPE IN ('STATION_TO_STATION', 'BIN_STORE_TO_ZONE')",
        "STATUS = 'COMPLETED'"
      ],
      "join_table": "hw_station_master",
      "join_condition": "task_master_log.destination_location_id = hw_station_master.location_id",
      "timestamp_column": "logged_timestamp",
      "primary_key": "TASK_ID",
      "count_expression": "COUNT(*) or COUNT(TASK_ID)",
      "additional_columns": [
        "TASK_ID (primary key - use this for counting)",
        "BOT_ID",
        "destination_location_id",
        "logged_timestamp",
        "UPDATED_TIMESTAMP",
        "END_TIME"
      ],
      "forbidden_columns": [
        "TASK_MASTER_LOG_ID (does NOT exist!)"
      ],
      "additional_joins": [
        {
          "table": "bot_master",
          "condition": "task_master_log.BOT_ID = bot_master.BOT_ID",
          "when": "grouping by bot or analyzing bot performance"
        }
      ],
      "grouping_options": {
        "by_station": "GROUP BY hw_station_master.STATION_ID, hw_station_master.STATION_ALIAS_NAME",
        "by_bot": "GROUP BY task_master_log.BOT_ID",
        "by_hour": "GROUP BY HOUR(logged_timestamp)",
        "by_date": "GROUP BY DATE(logged_timestamp)"
      },
      "triggers": [
        "bin presentation",
        "bins presented",
        "bins reached",
        "bins delivered",
        "bins delivered to station",
        "how many bins reached",
        "bin presentations per bot",
        "bin presentations per station",
        "bin presentations done per bot",
        "bin presentations done on station",
        "bin presentations done on each station",
        "bin presentations by bot",
        "bin presentations by station",
        "bins delivered per bot",
        "bins reached station",
        "bins to station",
        "average bin presentation",
        "hourly bin presentation",
        "hourly average bin presentation",
        "bin presentation per hour",
        "bin presentation average"
      ],
      "notes": "CRITICAL: Never use order_bin_mapping, station_pick_task_master, or recovery_pick_task_master for bin presentations. Always use task_master_log as the primary source. Each row in task_master_log with matching filters = 1 bin presentation. Use TASK_ID (NOT TASK_MASTER_LOG_ID which doesn't exist)."
    },
    "empty_bins": {
      "description": "Empty/available bins are identified by ARTICLE_ID = 'no-sku' in live_inventory_master",
      "required_table": "live_inventory_master",
      "required_filters": [
        "ARTICLE_ID = 'no-sku'",
        "IS_ACTIVE = 1"
      ],
      "timestamp_column": null,
      "triggers": [
        "empty bin",
        "empty bins",
        "available bin",
        "available bins",
        "free bin",
        "bins without sku",
        "bins with no sku"
      ]
    },
    "active_bots": {
      "description": "Active bots should be filtered by IS_ACTIVE = 1 and exclude bots in maintenance",
      "required_table": "bot_master",
      "required_filters": [
        "IS_ACTIVE = 1"
      ],
      "additional_filters": [
        "STATUS NOT IN ('MAINTENANCE', 'ERROR', 'OFFLINE')"
      ],
      "timestamp_column": null,
      "triggers": [
        "active bot",
        "active bots",
        "working bot",
        "operational bot",
        "bots in use"
      ]
    },
    "pending_orders": {
      "description": "Pending/incomplete orders should check STATUS column for specific values",
      "required_table": "wms_to_wcs_order_line_request_data",
      "required_filters": [
        "STATUS IN ('PENDING', 'IN_PROGRESS', 'ASSIGNED')"
      ],
      "timestamp_column": "INSERTED_TIMESTAMP",
      "triggers": [
        "pending order",
        "pending orders",
        "incomplete order",
        "orders not completed",
        "orders in progress"
      ]
    },
    "completed_orders": {
      "description": "Completed orders should filter by STATUS = 'COMPLETED'",
      "required_table": "wms_to_wcs_order_line_request_data",
      "required_filters": [
        "STATUS = 'COMPLETED'"
      ],
      "timestamp_column": "UPDATED_TIMESTAMP",
      "triggers": [
        "completed order",
        "completed orders",
        "finished order",
        "orders completed",
        "successful order"
      ]
    },
    "bot_charging": {
      "description": "Bot charging status and location - use bot_master with charging-specific columns",
      "required_table": "bot_master",
      "required_filters": [
        "STATUS = 'CHARGING'"
      ],
      "additional_columns": [
        "BATTERY_LEVEL",
        "CHARGING_STATION_ID"
      ],
      "timestamp_column": "LAST_UPDATED_TIMESTAMP",
      "triggers": [
        "bot charging",
        "bots charging",
        "charging bot",
        "bot battery",
        "bots at charging station"
      ]
    },
    "inventory_by_bin": {
      "description": "Current inventory levels per bin - use live_inventory_master with proper grouping",
      "required_table": "live_inventory_master",
      "required_filters": [
        "IS_ACTIVE = 1",
        "ARTICLE_ID != 'no-sku'"
      ],
      "join_table": "bin_info_master",
      "join_condition": "live_inventory_master.BIN_ID = bin_info_master.BIN_ID",
      "aggregate_by": "BIN_ID",
      "timestamp_column": null,
      "triggers": [
        "inventory per bin",
        "inventory by bin",
        "stock in each bin",
        "bin inventory level",
        "what's in each bin"
      ]
    },
    "task_completion_time": {
      "description": "Task duration/completion time - calculate from start to end timestamps",
      "required_table": "task_master_log",
      "required_filters": [
        "status = 'COMPLETED'"
      ],
      "time_calculation": "TIMESTAMPDIFF(SECOND, task_assigned_timestamp, logged_timestamp)",
      "timestamp_column": "logged_timestamp",
      "triggers": [
        "task duration",
        "task completion time",
        "how long task took",
        "task time",
        "average task time"
      ]
    },
    "sku_velocity": {
      "description": "SKU velocity/turnover - use order frequency from order data joined with SKU master",
      "required_table": "wms_to_wcs_order_line_request_data",
      "join_table": "sku_master",
      "join_condition": "wms_to_wcs_order_line_request_data.ARTICLE_ID = sku_master.SKU_ID",
      "required_filters": [
        "STATUS = 'COMPLETED'"
      ],
      "aggregate_by": "ARTICLE_ID",
      "timestamp_column": "INSERTED_TIMESTAMP",
      "triggers": [
        "sku velocity",
        "fast moving sku",
        "slow moving sku",
        "sku turnover",
        "most picked sku"
      ]
    },
    "completed_tasks": {
      "description": "Always filter by status = 'COMPLETED' when counting finished tasks",
      "applies_to": ["task_master_log", "task_detail_log"],
      "required_filter": "status = 'COMPLETED'"
    },
    "low_battery_bots": {
      "description": "Identifies bots with battery level below threshold requiring immediate charging or alerts",
      "required_table": "bot_master",
      "required_filters": ["BATTERY <= :battery_threshold"],
      "order_by": "BATTERY ASC",
      "timestamp_column": "UPDATED_TIMESTAMP",
      "triggers": [
        "low battery",
        "battery low",
        "battery alert",
        "bots need charging",
        "critical battery",
        "dying battery",
        "battery below"
      ]
    },
    "bot_fleet_health": {
      "description": "Overall fleet health check showing enabled bots with battery and alarm status",
      "required_table": "bot_master",
      "required_filters": ["IS_ACTIVE = 1"],
      "additional_filters": ["STATUS = 'ENABLED'"],
      "additional_columns": ["BATTERY", "ALARM"],
      "timestamp_column": null,
      "triggers": [
        "fleet health",
        "bot fleet",
        "bot status",
        "enabled bots",
        "active bots health",
        "overall bot status"
      ]
    },
    "recent_bot_alarms": {
      "description": "Recent bot alarms and alerts for monitoring and troubleshooting",
      "required_table": "bot_manual_alarm_log",
      "order_by": "INSERTED_TIMESTAMP DESC",
      "limit": 100,
      "timestamp_column": "INSERTED_TIMESTAMP",
      "triggers": [
        "recent alarms",
        "latest alarms",
        "alarm history",
        "bot alarms",
        "recent bot alarms",
        "alarm logs"
      ]
    },
