  "example_queries": {
    "bin_presentation_hourly": {
      "user_query": "Show me bin presentations by hour for each station in the last 12 hours",
      "sql": "SELECT HOUR(logged_timestamp) AS hour_, station_id, COUNT(*) AS bin_count FROM task_master_log tl JOIN hw_station_master hm ON tl.destination_location_id = hm.location_id WHERE task_type IN ('STATION_TO_STATION', 'BIN_STORE_TO_ZONE') AND tl.status = 'COMPLETED' AND logged_timestamp >= NOW() - INTERVAL 12 HOUR GROUP BY HOUR(logged_timestamp), station_id ORDER BY hour_, station_id",
      "tables": ["task_master_log", "hw_station_master"],
      "confidence": 0.95
    },
    "bin_presentation_daily": {
      "user_query": "Calculate bin presentations for each station in the last week",
      "sql": "SELECT s.STATION_ID, s.STATION_ALIAS_NAME, COUNT(*) AS bin_presentations, COUNT(DISTINCT DATE(tl.logged_timestamp)) AS days_active FROM hw_station_master s LEFT JOIN task_master_log tl ON tl.destination_location_id = s.location_id AND tl.task_type IN ('STATION_TO_STATION', 'BIN_STORE_TO_ZONE') AND tl.status = 'COMPLETED' AND tl.logged_timestamp >= NOW() - INTERVAL 7 DAY GROUP BY s.STATION_ID, s.STATION_ALIAS_NAME ORDER BY bin_presentations DESC",
      "tables": ["hw_station_master", "task_master_log"],
      "confidence": 0.95
    },
    "bin_presentation_station_performance": {
      "user_query": "What is the bin presentation for each station today",
      "sql": "SELECT hm.station_id, hm.STATION_ALIAS_NAME, COUNT(*) as bins_presented_today FROM task_master_log tl JOIN hw_station_master hm ON tl.destination_location_id = hm.location_id WHERE tl.task_type IN ('STATION_TO_STATION', 'BIN_STORE_TO_ZONE') AND tl.status = 'COMPLETED' AND DATE(tl.logged_timestamp) = CURDATE() GROUP BY hm.station_id, hm.STATION_ALIAS_NAME ORDER BY bins_presented_today DESC",
      "tables": ["task_master_log", "hw_station_master"],
      "confidence": 0.95
    },
    "bin_presentation_per_bot": {
      "user_query": "Show me bin presentations per bot in the last 24 hours",
      "sql": "SELECT tl.BOT_ID, bm.BOT_NAME, COUNT(*) AS bin_presentations FROM task_master_log tl LEFT JOIN bot_master bm ON tl.BOT_ID = bm.BOT_ID WHERE tl.task_type IN ('STATION_TO_STATION', 'BIN_STORE_TO_ZONE') AND tl.status = 'COMPLETED' AND tl.logged_timestamp >= NOW() - INTERVAL 24 HOUR GROUP BY tl.BOT_ID, bm.BOT_NAME ORDER BY bin_presentations DESC",
      "tables": ["task_master_log", "bot_master"],
      "confidence": 0.95
    },
    "bin_presentation_per_bot_timerange": {
      "user_query": "Compute bin presentations done per bot from 7 pm to 9 pm yesterday",
      "sql": "SELECT tl.BOT_ID, bm.BOT_NAME, COUNT(*) AS bin_presentations FROM task_master_log tl LEFT JOIN bot_master bm ON tl.BOT_ID = bm.BOT_ID WHERE tl.task_type IN ('STATION_TO_STATION', 'BIN_STORE_TO_ZONE') AND tl.status = 'COMPLETED' AND tl.logged_timestamp >= (CURDATE() - INTERVAL 1 DAY) + INTERVAL 19 HOUR AND tl.logged_timestamp < (CURDATE() - INTERVAL 1 DAY) + INTERVAL 21 HOUR GROUP BY tl.BOT_ID, bm.BOT_NAME ORDER BY bin_presentations DESC",
      "tables": ["task_master_log", "bot_master"],
      "confidence": 0.95
    },
    "bin_presentation_per_station_timerange": {
      "user_query": "Compute bin presentations done on each station from 7 pm to 9 pm yesterday",
      "sql": "SELECT hm.STATION_ID, hm.STATION_ALIAS_NAME, COUNT(*) AS bin_presentations FROM task_master_log tl JOIN hw_station_master hm ON tl.destination_location_id = hm.location_id WHERE tl.task_type IN ('STATION_TO_STATION', 'BIN_STORE_TO_ZONE') AND tl.status = 'COMPLETED' AND tl.logged_timestamp >= (CURDATE() - INTERVAL 1 DAY) + INTERVAL 19 HOUR AND tl.logged_timestamp < (CURDATE() - INTERVAL 1 DAY) + INTERVAL 21 HOUR GROUP BY hm.STATION_ID, hm.STATION_ALIAS_NAME ORDER BY bin_presentations DESC",
      "tables": ["task_master_log", "hw_station_master"],
      "confidence": 0.95
    }
  }
