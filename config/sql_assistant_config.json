    "sku_inventory_by_name": {
      "description": "Find inventory/bins for a product/SKU by NAME (not ID). CRITICAL: When user provides a product/SKU NAME (not ID), you MUST join with article_master to resolve the name to ARTICLE_ID first.",
      "required_table": "live_inventory_master",
      "required_joins": [
        "JOIN article_master am ON lim.ARTICLE_ID = am.ARTICLE_ID",
        "LEFT JOIN bin_info_master bim ON lim.BIN_ID = bim.BIN_ID"
      ],
      "name_matching_column": "am.ARTICLE_NAME",
      "name_matching_pattern": "Use LIKE '%{product_name}%' or exact match on am.ARTICLE_NAME",
      "required_filters": [
        "am.ARTICLE_NAME LIKE '%{product_name}%' (when user provides product name)",
        "lim.IS_ACTIVE = 1",
        "(lim.QUANTITY > 0 OR lim.VIRTUAL_QUANTITY_TO_PICK > 0 OR lim.VIRTUAL_QUANTITY_TO_PUT > 0)"
      ],
      "additional_columns": [
        "am.ARTICLE_NAME",
        "am.ARTICLE_ID", 
        "lim.BIN_ID",
        "bim.BIN_BARCODE",
        "lim.QUANTITY",
        "lim.BATCH_ID"
      ],
      "critical_notes": [
        "NEVER use ARTICLE_ID LIKE '%name%' - this is WRONG!",
        "Product names are in article_master.ARTICLE_NAME, not in ARTICLE_ID",
        "ALWAYS join with article_master when user mentions product/SKU name",
        "ARTICLE_ID is a numeric or coded ID, not a name",
        "If user says 'sku name', 'product name', 'article name', or provides a text name → use article_master.ARTICLE_NAME",
        "If user provides just a number or code → use ARTICLE_ID directly"
      ],
      "order_by": "lim.BIN_ID, lim.SEGMENT_NO",
      "triggers": [
        "sku name",
        "product name",
        "article name",
        "item name",
        "which bins",
        "bins for",
        "inventory for",
        "where is",
        "location of product",
        "location of sku",
        "stock location",
        "find product",
        "find sku",
        "find item",
        "product in bins",
        "sku in bins"
      ]
    },
    "bin_location_mapping": {
