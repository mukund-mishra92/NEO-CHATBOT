# NEO Chatbot - Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ================================
# APPLICATION SETTINGS
# ================================
DEBUG=false
LOG_LEVEL=INFO

# ================================
# SERVER CONFIGURATION
# ================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true
CORS_ORIGINS=*

# ================================
# DATABASE CONFIGURATION
# ================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=neo

# ================================
# AI/LLM API KEYS
# ================================
# Groq (Fast inference - Recommended)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (Alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# HuggingFace (For FREE embeddings)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HF_TOKEN=your_huggingface_api_key_here

# ================================
# LOCAL LLM CONFIGURATION
# ================================
LOCAL_LLM_ENABLED=true
LOCAL_LLM_MODEL=tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
LOCAL_LLM_MAX_TOKENS=500
LOCAL_LLM_TEMPERATURE=0.3

# ================================
# AGENTIC AI CONFIGURATION
# ================================
AGENTIC_MODE_ENABLED=true
AGENTIC_VERIFICATION_THRESHOLD=100
# Max retry iterations before forcing stop (1 = allow 1 retry, 0 = no retries)
AGENTIC_MAX_ITERATIONS=1
# Maximum execution time in seconds before timeout (prevents infinite loops)
AGENTIC_TIMEOUT_SECONDS=60

# ================================
# VECTOR STORE CONFIGURATION
# ================================
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# ================================
# TESSERACT OCR (Optional for image OCR)
# ================================
# Windows: C:/Program Files/Tesseract-OCR/tesseract.exe
# Linux: /usr/bin/tesseract
# TESSERACT_CMD=path_to_tesseract
