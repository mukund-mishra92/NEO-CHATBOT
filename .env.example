# .env.example - NEO Chatbot Configuration

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=neo

# ============================================
# AI/LLM API KEYS
# ============================================

# OpenAI (REQUIRED for GPT-4 SQL Assistant)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Groq (Fast inference API - optional fallback)
# Get your key from: https://console.groq.com
GROQ_API_KEY=your-groq-key-here

# Anthropic Claude (optional fallback)
# Get your key from: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-key-here

# HuggingFace (for embeddings)
# Get your key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your-hf-token-here

# ============================================
# SQL ASSISTANT CONFIGURATION
# ============================================

# SQL Assistant Mode
# "gpt4"   = NEW GPT-4 Multi-Layer Architecture (RECOMMENDED)
#            - Uses GPT-4o for query generation
#            - Uses o1 for retry with extended thinking
#            - Requires OPENAI_API_KEY
#            - Best accuracy and error handling
#
# "phase3" = Legacy Semantic Frame Architecture
#            - Uses Groq/local LLM
#            - Deterministic SQL building
#            - No OpenAI required
SQL_ASSISTANT_MODE=gpt4

# ============================================
# LOCAL LLM CONFIGURATION (Fallback)
# ============================================
LOCAL_LLM_ENABLED=true
LOCAL_LLM_MODEL=tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
LOCAL_LLM_MAX_TOKENS=500
LOCAL_LLM_TEMPERATURE=0.3

# ============================================
# AGENTIC AI CONFIGURATION
# ============================================
AGENTIC_MODE_ENABLED=true
AGENTIC_VERIFICATION_THRESHOLD=100

# ============================================
# VECTOR STORE CONFIGURATION
# ============================================
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# ============================================
# SERVER CONFIGURATION
# ============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGINS=*

# ============================================
# QUICK START GUIDE
# ============================================
#
# 1. Copy this file to .env
#    cp .env.example .env
#
# 2. Add your OpenAI API key (REQUIRED for GPT-4 mode)
#    OPENAI_API_KEY=sk-your-key-here
#
# 3. Configure database settings
#    DB_HOST=localhost
#    DB_PASSWORD=your_password
#
# 4. Choose SQL Assistant mode
#    SQL_ASSISTANT_MODE=gpt4  (recommended)
#
# 5. Start the server
#    python -m uvicorn app.main:app --reload
#
# ============================================
